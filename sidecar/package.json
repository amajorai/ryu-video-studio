{
  "name": "@ryu/video-studio-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "test": "bun test src --max-concurrency=1",
    "check-types": "tsc --noEmit",
    "build": "bun build src/index.ts src/sync-worker.ts src/mesh-render-worker.ts --root src --compile --outfile dist/ryu-video-studio",
    "test:media": "bun src/verify-media.ts",
    "verify:otio": "bun src/verify-otio.ts"
  },
  "dependencies": {
    "@ryu/sidecar-runtime": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5",
    "@types/node": "^25.4.0"
  }
}
