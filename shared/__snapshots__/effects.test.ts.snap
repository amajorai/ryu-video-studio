  "grayscale": [
    "hue=s=0.500",
  ],
  "hue-cycle": [
    "hue=h='t*45'",
  ],
  "invert": [
    "format=rgba,format=gbrap,split[fxA_0xd][fxA_0xw];[fxA_0xw]negate,format=gbrap[fxA_0xm];[fxA_0xm][fxA_0xd]blend=all_mode=normal:all_opacity=0.5:c3_opacity=0",
  ],
  "letterbox": [
    "drawbox=x=0:y=0:w=iw:h=ih*0.06:color=black:t=fill",
    "drawbox=x=0:y=ih-ih*0.06:w=iw:h=ih*0.06:color=black:t=fill",
  ],
  "light-leak": [
    "format=rgba,format=gbrap,split[fxA_0d][fxA_0l];[fxA_0l]lutrgb=r=255:g=255:b=255,vignette=angle=PI/2:x0='w*(0.18+0.12*sin(t*0.6+0.9167))':y0='h*(0.2+0.1*cos(t*0.45+0.9167))':eval=frame,lutrgb=r='val':g='val*0.59':b='val*0.22',format=gbrap[fxA_0o];[fxA_0d][fxA_0o]blend=all_mode=screen:all_opacity=0.5:c3_mode=normal:c3_opacity=1",
  ],
  "mirror": [
    "format=rgba,format=gbrap,split[fxA_0a][fxA_0f];[fxA_0f]hflip,crop=w=iw/2:h=ih:x=iw-ow:y=0[fxA_0h];[fxA_0a][fxA_0h]overlay=x=W-w:y=0:format=auto",
  ],
  "mosaic": [
    "pixelize=w=17:h=17",
  ],
  "motion-blur": [
    "tmix=frames=5",
  ],
  "relight": [
    "format=rgba,format=gbrap,split[fxA_0d][fxA_0l];[fxA_0l]lutrgb=r=255:g=255:b=255,vignette=angle=PI/2:x0='w*(0.3)':y0='h*(0.25)':eval=frame,lutrgb=r='70+val*0.725':g='68+val*0.7':b='63+val*0.64',format=gbrap[fxA_0o];[fxA_0d][fxA_0o]blend=all_mode=softlight:all_opacity=0.5:c3_mode=normal:c3_opacity=1",
  ],
  "rgb-split": [
    "rgbashift=rh=-4:bh=4",
  ],
  "sepia": [
