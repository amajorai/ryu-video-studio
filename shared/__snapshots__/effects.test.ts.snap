exports[`effect library filters every effect has a label and a filter snapshot at half amount 1`] = `
{
  "blur": [
    "boxblur=luma_radius=3.00:luma_power=1",
  ],
  "clarity": [
    "unsharp=13:13:0.75",
  ],
  "dehaze": [
    "eq=contrast=1.15:saturation=1.125:brightness=-0.02",
    "curves=master='0/0 0.25/0.21 1/1'",
  ],
  "denoise": [
    "hqdn3d=2:1.5:3:2.25",
  ],
  "echo": [
    "lagfun=decay=0.945",
  ],
  "edge-detect": [
    "format=rgba,format=gbrap,split[fxA_0xd][fxA_0xw];[fxA_0xw]format=gbrp,edgedetect=mode=colormix:high=0.2:low=0.05,format=gbrap[fxA_0xm];[fxA_0xm][fxA_0xd]blend=all_mode=normal:all_opacity=0.5:c3_opacity=0",
  ],
  "glitch": [
    "rgbashift=rh=12:gh=-5:bv=3:enable='lt(mod(t+0.1459,1.3),0.18)'",
