  ],
  "shake": [
    "crop=w='2*trunc(iw*0.96/2)':h='2*trunc(ih*0.96/2)':x='(iw-ow)/2*(1+(1)*(0.6*sin(t*31+0.9167)+0.4*sin(t*17.3+0.9167*2)))':y='(ih-oh)/2*(1+(1)*(0.6*sin(t*27+0.9167)+0.4*sin(t*13.1+0.9167*2)))'",
    "scale=w='2*trunc(iw/0.96/2+0.5)':h='2*trunc(ih/0.96/2+0.5)'",
